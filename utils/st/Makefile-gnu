PREFIX   ?= /usr/local
MANPREFIX = $(PREFIX)/share/man

PKGS = x11 xft fontconfig
CPPFLAGS = -D_DEFAULT_SOURCE -D_XOPEN_SOURCE=600 $(shell pkg-config --cflags $(PKGS) 2>/dev/null)
CFLAGS  += -std=c99 -pedantic -Wall -Os
LDLIBS   = $(shell pkg-config --libs $(PKGS) 2>/dev/null || echo "-lX11 -lXft -lfontconfig") -lm -lrt

SRC = st.c x.c
OBJ = $(SRC:.c=.o)
BIN = st

all: $(BIN)

config.h:
	cp config.def.h config.h

$(OBJ): config.h st.h win.h arg.h

$(BIN): $(OBJ)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(LDLIBS)

clean:
	rm -f st $(OBJ)

install: $(BIN)
	install -Dm755 st $(DESTDIR)$(PREFIX)/bin/st
	install -Dm644 st.1 $(DESTDIR)$(MANPREFIX)/man1/st.1
	sed -i $(DESTDIR)$(MANPREFIX)/man1/st.1
	tic -sx st.info

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/st
	rm -f $(DESTDIR)$(MANPREFIX)/man1/st.1

.PHONY: all clean install uninstall
